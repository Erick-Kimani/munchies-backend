APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# CSRF / HTTPONLY-COOKIE AUTH: the session cookie is what the SPA is now
# authenticated with (see AuthController + bootstrap/app.php), so these
# three matter a lot more than they used to:
#   - SESSION_SECURE_COOKIE: leave unset/false for local http:// dev.
#     MUST be true in production (cookie is only sent over https).
#   - SESSION_SAME_SITE: 'lax' works when the frontend and backend share
#     the same registrable domain (e.g. localhost:5173 -> localhost:8000,
#     or app.example.com -> api.example.com IS still "different" — see
#     below). Use 'none' (and SESSION_SECURE_COOKIE=true, which browsers
#     require alongside SameSite=None) if the frontend is served from a
#     genuinely different domain than the API.
#   - SESSION_DOMAIN: leave null for local dev. In production, if the
#     frontend and API are on sibling subdomains of the same domain
#     (app.example.com / api.example.com), set this to
#     ".example.com" so the cookie is shared between them.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# CSRF / HTTPONLY-COOKIE AUTH: comma-separated list of frontend origins
# (host[:port], no scheme) allowed to receive the stateful session/CSRF
# cookies. Must be kept in sync with config/cors.php's allowed_origins.
# Falls back to a sensible localhost list (see config/sanctum.php) if
# unset, so this is only required in production.
# SANCTUM_STATEFUL_DOMAINS=app.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- M-Pesa Daraja ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_LISTING_FEE=1

VITE_APP_NAME="${APP_NAME}"